config_version=5

[application]

config/name="Ashbinders"
config/description="An open-world dark-fantasy RPG of buried fire and borrowed memory"
config/version="0.1.0-phase1"
run/main_scene="res://scenes/test/gym_underlevels.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="Ashbinders"

