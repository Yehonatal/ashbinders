# Godot 4 & C# / .NET .gitignore

# Godot 4 specific ignores
.godot/
*.translation
game/.godot/

# C# / .NET specific ignores
bin/
obj/
*.user
*.userosscache
*.sln.docstates
.vs/
.vscode/
.idea/
*.suo
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Dotnet CLI & NuGet Local Caches
.dotnet/
.nuget/
packages/

# Build and Export outputs
build/
dist/
game/export/

# Ignore export contents, but keep the export/web/ directory in the repo
# so Dockerfile.web's COPY step always has something to copy.
export/*
!export/web/
export/web/*
!export/web/.gitkeep

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Logs & crash dumps
*.log
*.dmp
crash_dump*

# Temporary files
*.tmp
*~
*.swp
*.bak

# Packages
*.nupkg
project.lock.json
project.assets.json

# Claude Code
.claude/
.env