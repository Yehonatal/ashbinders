    <Compile Include="..\game\core\events\IGameEvent.cs" Link="Core\IGameEvent.cs" />
    <Compile Include="..\game\core\events\EventBus.cs" Link="Core\EventBus.cs" />
    <Compile Include="..\game\core\logging\GameLogger.cs" Link="Core\GameLogger.cs" />
    <Compile Include="..\game\core\save\ISaveable.cs" Link="Core\ISaveable.cs" />
    <Compile Include="..\game\core\save\SaveData.cs" Link="Core\SaveData.cs" />
    <Compile Include="..\game\core\save\SaveManager.cs" Link="Core\SaveManager.cs" />
    <Compile Include="..\game\embers\core\EmberType.cs" Link="Embers\EmberType.cs" />
    <Compile Include="..\game\gameplay\damage\DamageType.cs" Link="Gameplay\DamageType.cs" />
